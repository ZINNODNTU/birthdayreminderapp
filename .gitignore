firebase-export/

# 🔒 Firebase generated files (regenerate via flutterfire configure)
# Do NOT commit per-environment google-services.json — use CI to generate
# For local dev, keep in .gitignore
# Android: android/app/google-services.json
# iOS: ios/Runner/GoogleService-Info.plist

# 🔒 Crashlytics / build artifacts
crashlytics-build.properties

# 🔒 IDE
.idea/
.vscode/

# 🔒 Phase 7 release output (APK + manifest live here for self-update staging)
dist/

# 🔒 Android Gradle intermediate reports (regenerated on each build)
android/build/

# 🔒 Firebase emulator runtime logs (regenerated when emulator starts)
firestore-debug.log

# 🔒 Temporary instrumentation from local dev sessions
inst_user_settings.tmp

# 🔒 Local release/audit outputs and temporary Firebase copy
artifacts/
/new_google-services.json

# Local generated release metadata
/release-metadata.json
android/key.properties
*.jks
