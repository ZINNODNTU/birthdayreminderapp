rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function googleUser() {
      return request.auth != null &&
        (request.auth.token.provider == 'google.com' ||
         (request.auth.token.firebase != null && request.auth.token.firebase.sign_in_provider == 'google.com'));
    }
    function uuidV4(id) {
      return id.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$');
    }
    function validProfile(uid) {
      return request.resource.data.keys().hasOnly([
        'uid', 'createdAt', 'updatedAt', 'lastLoginAt', 'displayName',
        'email', 'photoUrl', 'provider', 'schemaVersion'
      ]) && request.resource.data.uid == uid
        && request.resource.data.provider == 'google.com'
        && request.resource.data.schemaVersion == 2;
    }
    function validBirthday(id) {
      return uuidV4(id)
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'birthdayDate', 'calendarType', 'relationship',
          'gender', 'note', 'photoBase64', 'photoMimeType', 'photoSize',
          'photoHash', 'photoUpdatedAt', 'reminderEnabled',
          'remindBeforeDays', 'reminderTime', 'repeatYearly',
          'createdAt', 'updatedAt', 'schemaVersion'
        ])
        && request.resource.data.id == id
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.birthdayDate is timestamp
        && request.resource.data.calendarType in ['solar', 'lunar']
        && (!('relationship' in request.resource.data)
          || request.resource.data.relationship is string)
        && (!('gender' in request.resource.data)
          || request.resource.data.gender is string)
        && request.resource.data.remindBeforeDays is int
        && request.resource.data.remindBeforeDays >= 0
        && request.resource.data.reminderEnabled is bool
        && request.resource.data.reminderTime is string
        && request.resource.data.reminderTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.repeatYearly is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.schemaVersion == 2
        && (!('photoBase64' in request.resource.data) ||
          (request.resource.data.photoBase64 is string
            && request.resource.data.photoBase64.size() > 0
            && request.resource.data.photoBase64.size() <= 700 * 1024))
        && (!('photoMimeType' in request.resource.data)
          || request.resource.data.photoMimeType is string)
        && (!('photoSize' in request.resource.data)
          || (request.resource.data.photoSize is int
            && request.resource.data.photoSize >= 0))
        && (!('photoHash' in request.resource.data)
          || request.resource.data.photoHash is string)
        && (!('photoUpdatedAt' in request.resource.data)
          || request.resource.data.photoUpdatedAt is timestamp);
    }

    match /users/{uid} {
      allow read, delete: if owner(uid);
      allow create: if owner(uid) && googleUser() && validProfile(uid);
      allow update: if owner(uid) && googleUser() && validProfile(uid)
        && request.resource.data.createdAt == resource.data.createdAt;

      match /birthdays/{birthdayId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && validBirthday(birthdayId);
      }
      match /preferences/{document=**} { allow read, write: if owner(uid); }
      match /devices/{deviceId} { allow read, write: if owner(uid); }
    }
    match /birthdays/{document=**} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
